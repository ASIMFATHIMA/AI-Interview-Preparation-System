# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Database Configuration (MySQL)
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_career_companion

# Database URL string
# Format: mysql+pymysql://USERNAME:PASSWORD@localhost:3306/ai_career_companion
DATABASE_URL=mysql+pymysql://your_db_username:your_db_password@localhost:3306/ai_career_companion

# JWT Authentication (Placeholder for upcoming module)
SECRET_KEY=your_super_secret_jwt_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
