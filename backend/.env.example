# Copy this file to .env and fill in real values. Never commit .env itself.

# Anthropic API key used for LLM-based resume extraction (and future agents)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Claude model to use for structured extraction
ANTHROPIC_MODEL=claude-sonnet-4-6

# Database URL. Defaults to local SQLite file if unset.
DATABASE_URL=sqlite:///./internship_copilot.db

# Directory where uploaded resumes are stored
UPLOAD_DIR=./uploads
